aws_region = "eu-central-1"

project_name = "vpc-private-rds-bastion"

environment = "dev"

vpc_cidr = "10.0.0.0/16"

availability_zones = [
  "eu-central-1a",
  "eu-central-1b"
]

public_subnet_cidrs = [
  "10.0.1.0/24",
  "10.0.2.0/24"
]

private_subnet_cidrs = [
  "10.0.11.0/24",
  "10.0.12.0/24"
]

# Replace with your actual public IP.
# /32 means exactly one IPv4 address.
admin_ip_cidr = "203.0.113.10/32"

# Existing EC2 Key Pair name in AWS.
bastion_key_name = "my-bastion-key"

bastion_instance_type = "t3.micro"

db_name = "appdb"

db_master_user = "dbadmin"

pg_engine_version = "16"

rds_instance_class = "db.t4g.micro"

rds_allocated_storage = 20

rds_max_allocated_storage = 100

rds_backup_retention_period = 7
